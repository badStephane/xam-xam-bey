# En-têtes HTTP du site, lus par Cloudflare Pages (fichier copié tel quel dans dist/).
# Lot 3 (E5) : polices servies par le site (assets/*.woff2) : Google Fonts retiré de style-src et font-src.
# font-src garde data: (polices intégrées aux PDF par pdf.js). Le service worker (sw.js, même origine) relève de script-src 'self'.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self' https://gkogjfsvaqxbqdphjhaq.supabase.co wss://gkogjfsvaqxbqdphjhaq.supabase.co; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/pdfjs/*
  Cache-Control: public, max-age=604800

# Service worker (lot 3, E3) : toujours revérifié, pour qu'un déploiement (ou le worker de secours) soit pris tout de suite.
/sw.js
  Cache-Control: no-cache
